#!/bin/bash

set -eu

script_dir=$(cd "$(dirname "$0")" && pwd)
program="$script_dir/../bin/git-update-all.sh"
test_dir=$(mktemp -d /tmp/git-update-all-test_XXXXXX)
trap 'rm -rf "$test_dir"' EXIT

export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME='Git Update Test'
export GIT_AUTHOR_EMAIL='git-update-test@example.com'
export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
export GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL

seed="$test_dir/seed"
remote="$test_dir/remote.git"
repos="$test_dir/repositories"
repo="$repos/primary repo"
worktrees="$test_dir/worktrees"

mkdir "$repos" "$worktrees"
git init --quiet --initial-branch=main "$seed"
printf 'initial\n' > "$seed/file"
git -C "$seed" add file
git -C "$seed" commit --quiet -m initial

for branch in already-gone current dirty divergent dormant excluded \
	fast-forward linked locked; do
    git -C "$seed" branch "$branch"
done

git init --quiet --bare --initial-branch=main "$remote"
git -C "$seed" remote add origin "$remote"
git -C "$seed" push --quiet --all origin
git clone --quiet "$remote" "$repo"

git -C "$repo" branch --quiet --track already-gone origin/already-gone
git -C "$repo" branch --quiet --track dormant origin/dormant
git -C "$repo" branch --quiet --track excluded origin/excluded
git -C "$repo" branch --quiet --track fast-forward origin/fast-forward
fast_forward_oid=$(git -C "$repo" rev-parse refs/heads/fast-forward)

linked_worktree="$worktrees/linked tree"
dirty_worktree="$worktrees/dirty tree"
divergent_worktree="$worktrees/divergent tree"
locked_worktree="$worktrees/locked tree"
git -C "$repo" worktree add --quiet -b linked \
    "$linked_worktree" origin/linked
git -C "$repo" worktree add --quiet -b dirty \
    "$dirty_worktree" origin/dirty
git -C "$repo" worktree add --quiet -b divergent \
    "$divergent_worktree" origin/divergent
git -C "$repo" worktree add --quiet -b locked \
    "$locked_worktree" origin/locked

# A clean worktree can still contain an unpushed commit and must be kept.
printf 'local commit\n' >> "$divergent_worktree/file"
git -C "$divergent_worktree" add file
git -C "$divergent_worktree" commit --quiet -m divergent

# Dirty and locked worktrees must also be kept.
printf 'uncommitted change\n' >> "$dirty_worktree/file"
git -C "$repo" worktree lock "$locked_worktree"

git -C "$repo" switch --quiet -c current origin/current

# Exercise the fallback for a branch whose upstream was gone before startup.
git --git-dir="$remote" update-ref -d refs/heads/already-gone
git -C "$repo" fetch --quiet --prune origin

# Updating the current branch must not rewrite commits when local and remote
# have diverged, even when pull.rebase is configured.
git -C "$repo" switch --quiet main
git -C "$repo" commit --quiet --allow-empty -m local-main
local_main_oid=$(git -C "$repo" rev-parse refs/heads/main)
git -C "$repo" switch --quiet current
git -C "$seed" commit --quiet --allow-empty -m remote-main
git -C "$seed" push --quiet origin main
remote_main_oid=$(git -C "$seed" rev-parse refs/heads/main)
git --git-dir="$remote" update-ref refs/heads/fast-forward "$remote_main_oid"
git -C "$repo" config pull.rebase true

# Configured pruning must not be able to target local branches or tags.  A
# negative refspec must not hide a branch which is still present remotely.
git -C "$repo" update-ref -d refs/remotes/origin/excluded
git -C "$repo" config --add remote.origin.fetch '^refs/heads/excluded'
git -C "$repo" switch --quiet -c archive/precious
git -C "$repo" commit --quiet --allow-empty -m local-only
precious_oid=$(git -C "$repo" rev-parse refs/heads/archive/precious)
git -C "$repo" switch --quiet current
git -C "$repo" tag local-only-tag
git -C "$repo" config fetch.prune true
git -C "$repo" config fetch.pruneTags true
git -C "$repo" config --add remote.origin.fetch \
    '+refs/archive/*:refs/heads/archive/*'

for branch in current dirty divergent dormant linked locked; do
    git --git-dir="$remote" update-ref -d "refs/heads/$branch"
done

output="$test_dir/output"
(
    cd "$repos"
    "$program" --prune-local > "$output" 2>&1
)

if [ "$(git -C "$repo" symbolic-ref --short HEAD)" != main ]; then
    echo 'git-update-all: primary worktree did not switch to main.' >&2
    exit 1
fi

if [ "$(git -C "$repo" rev-parse refs/heads/main)" != "$local_main_oid" ]; then
    echo 'git-update-all: update rewrote a local commit.' >&2
    exit 1
fi

for branch in already-gone current dormant linked; do
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
	echo "git-update-all: local branch '$branch' was not pruned." >&2
	exit 1
    fi
done

if [ -e "$linked_worktree" ]; then
    echo 'git-update-all: clean linked worktree was not removed.' >&2
    exit 1
fi

for branch in dirty divergent locked; do
    if ! git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
	echo "git-update-all: protected branch '$branch' was pruned." >&2
	exit 1
    fi
done

if ! git -C "$repo" show-ref --verify --quiet refs/heads/archive/precious ||
	[ "$(git -C "$repo" rev-parse refs/heads/archive/precious)" != \
	    "$precious_oid" ] ||
	! git -C "$repo" show-ref --verify --quiet refs/heads/excluded ||
	! git -C "$repo" show-ref --verify --quiet refs/remotes/origin/excluded ||
	! git -C "$repo" show-ref --verify --quiet refs/tags/local-only-tag; then
    echo 'git-update-all: fetch pruning changed a protected local ref.' >&2
    exit 1
fi

for worktree in "$dirty_worktree" "$divergent_worktree" "$locked_worktree"; do
    if [ ! -d "$worktree" ]; then
	echo "git-update-all: protected worktree '$worktree' was removed." >&2
	exit 1
    fi
done

if ! grep -q "worktree '$dirty_worktree' is not pristine" "$output" ||
        ! grep -q "tip differs from the last-fetched upstream" "$output" ||
        ! grep -q "worktree '$locked_worktree' is locked" "$output"; then
    echo 'git-update-all: preservation reasons were not reported.' >&2
    exit 1
fi

# Without --prune-local, report eligible branches without deleting them.
report_oid=$(git --git-dir="$remote" rev-parse refs/heads/main)
git --git-dir="$remote" update-ref refs/heads/report-only "$report_oid"
git -C "$repo" update-ref refs/remotes/origin/report-only "$report_oid"
git -C "$repo" branch --quiet --track report-only origin/report-only
git --git-dir="$remote" update-ref -d refs/heads/report-only
git -C "$repo" switch --quiet report-only
(
    cd "$repos"
    "$program" > "$test_dir/report-output" 2>&1
)

if ! git -C "$repo" show-ref --verify --quiet refs/heads/report-only ||
        [ "$(git -C "$repo" symbolic-ref --short HEAD)" != report-only ] ||
        ! grep -q "Would switch .*prune local branch 'report-only'" \
            "$test_dir/report-output" ||
	! grep -q "Skipping update: the current branch's upstream is gone" \
            "$test_dir/report-output"; then
    echo 'git-update-all: report-only mode changed or omitted a candidate.' >&2
    exit 1
fi

# Even an ignored file prevents updating the worktree.  Once it is removed, a
# branch without local commits fast-forwards from the safely fetched tracking
# ref.
git -C "$repo" switch --quiet fast-forward
printf 'ignored-local\n' > "$repo/.git/info/exclude"
printf 'preserve me\n' > "$repo/ignored-local"
(
    cd "$repos"
    "$program" > "$test_dir/ignored-output" 2>&1
)
if [ "$(git -C "$repo" rev-parse refs/heads/fast-forward)" != \
	"$fast_forward_oid" ] || [ ! -f "$repo/ignored-local" ] ||
	! grep -q 'current worktree is not pristine' \
	    "$test_dir/ignored-output"; then
    echo 'git-update-all: update did not preserve an ignored local file.' >&2
    exit 1
fi
rm "$repo/ignored-local"
(
    cd "$repos"
    "$program" > "$test_dir/fast-forward-output" 2>&1
)
if [ "$(git -C "$repo" rev-parse refs/heads/fast-forward)" != \
	"$remote_main_oid" ]; then
    echo 'git-update-all: current branch was not fast-forwarded.' >&2
    exit 1
fi

if ! "$program" --help | grep -q '^Usage: git-update-all.sh \[--prune-local\]$'; then
    echo 'git-update-all: help test failed.' >&2
    exit 1
fi
if "$program" --unknown > /dev/null 2>&1; then
    echo 'git-update-all: invalid option test failed.' >&2
    exit 1
fi

echo 'git-update-all: good.'
