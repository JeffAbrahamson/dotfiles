#!/usr/bin/env python3
"""Inventory Git repositories and compare inventories from multiple hosts."""

import argparse
import json
import os
from pathlib import Path
import shlex
import socket
import subprocess
import sys
import tempfile
from collections import Counter, defaultdict
from datetime import datetime, timezone


def find_repositories(root):
    """Return repository entries below root, sorted by relative path."""
    repositories = []
    for current, directories, _files in os.walk(root):
        directories.sort()
        current_path = Path(current)
        marker = current_path / ".git"
        if marker.is_dir() or marker.is_file():
            relative_path = current_path.relative_to(root).as_posix()
            if relative_path == ".":
                relative_path = "."
            remote = subprocess.run(
                [
                    "git",
                    "-C",
                    str(current_path),
                    "remote",
                    "get-url",
                    "origin",
                ],
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
            )
            origin = remote.stdout.strip() if remote.returncode == 0 else None
            repositories.append({"path": relative_path, "origin": origin})
            directories[:] = []
    return sorted(repositories, key=lambda entry: entry["path"])


def manifest_for(host, root):
    return {
        "schema_version": 1,
        "host": host,
        "generated_at": datetime.now(timezone.utc).isoformat(
            timespec="seconds"
        ),
        "source": str(root),
        "repositories": find_repositories(root),
    }


def write_manifest(directory, manifest):
    directory.mkdir(parents=True, exist_ok=True)
    destination = directory / (manifest["host"] + ".json")
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=directory, delete=False
        ) as output:
            temporary = Path(output.name)
            json.dump(manifest, output, indent=2, sort_keys=True)
            output.write("\n")
        temporary.replace(destination)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return destination


def scan(args):
    root = args.src_dir.expanduser()
    if not root.is_dir():
        raise ValueError("source directory does not exist: {}".format(root))
    host = args.host or socket.gethostname()
    manifest = manifest_for(host, root)
    output = write_manifest(args.manifest_dir.expanduser(), manifest)
    print(
        "{}: recorded {} repositories in {}".format(
            host, len(manifest["repositories"]), output
        )
    )
    return manifest


def load_manifests(directory):
    manifests = []
    for path in sorted(directory.glob("*.json")):
        try:
            with path.open(encoding="utf-8") as source:
                manifest = json.load(source)
            if (
                manifest.get("schema_version") != 1
                or not isinstance(manifest.get("host"), str)
                or not isinstance(manifest.get("repositories"), list)
                or any(
                    not isinstance(entry, dict)
                    or not isinstance(entry.get("path"), str)
                    or Path(entry.get("path", "")).is_absolute()
                    or ".." in Path(entry.get("path", "")).parts
                    or (
                        entry.get("origin") is not None
                        and not isinstance(entry.get("origin"), str)
                    )
                    for entry in manifest.get("repositories", [])
                )
            ):
                raise ValueError("unsupported or malformed manifest")
            manifests.append(manifest)
        except (
            OSError,
            json.JSONDecodeError,
            ValueError,
            AttributeError,
        ) as error:
            print(
                "repo-map: skipping {}: {}".format(path, error),
                file=sys.stderr,
            )
    return manifests


def shell_command(*parts):
    return " ".join(shlex.quote(str(part)) for part in parts)


def destination_problem(root, relative_path, repository_paths):
    destination = root / relative_path
    if destination.exists() or destination.is_symlink():
        return "destination already exists"
    relative = Path(relative_path)
    for parent in relative.parents:
        if parent == Path("."):
            break
        parent_name = parent.as_posix()
        parent_path = root / parent_name
        if parent_name in repository_paths:
            return "destination is inside repository {}".format(parent_name)
        if parent_path.exists() and not parent_path.is_dir():
            return "parent path is not a directory: {}".format(parent_name)
    return None


def suggested_command(root, relative_path, *command):
    parent = (root / relative_path).parent
    parts = []
    if not parent.is_dir():
        parts.append(shell_command("mkdir", "-p", "--", parent))
    parts.append(shell_command(*command))
    return " && ".join(parts)


def short_time(manifest):
    """Return a manifest's generation time to the minute, for headers."""
    return str(manifest.get("generated_at", "unknown age"))[:16]


def host_list(hosts):
    return ", ".join(hosts)


def print_group(title, rows):
    """Print one line per repository, aligning the host column."""
    if not rows:
        return
    print("\n{} ({}):".format(title, len(rows)))
    rows = sorted(rows)
    width = min(max(len(name) for name, _detail in rows), 60)
    for name, detail in rows:
        print("  {}  {}".format(name.ljust(width), detail))


def reconcile(args):
    current = scan(args)
    root = args.src_dir.expanduser()
    manifests = load_manifests(args.manifest_dir.expanduser())
    # Prefer the just-written copy if a malformed or stale duplicate host file
    # was present under a different filename.
    by_host = {manifest["host"]: manifest for manifest in manifests}
    by_host[current["host"]] = current
    others = [
        by_host[name] for name in sorted(by_host) if name != current["host"]
    ]
    if not others:
        print("Only one host manifest is available; scan other hosts first.")
        return current

    # "Majority" means a strict majority of the other hosts, so that the
    # comparison is useful with two hosts as well as with many.
    print(
        "Comparing {} with {} other host(s): {}".format(
            current["host"],
            len(others),
            ", ".join(
                "{} ({})".format(m["host"], short_time(m)) for m in others
            ),
        )
    )

    local_paths = {entry["path"]: entry for entry in current["repositories"]}
    local_by_origin = defaultdict(list)
    for entry in current["repositories"]:
        if entry.get("origin"):
            local_by_origin[entry["origin"]].append(entry["path"])
    unlinked = len(current["repositories"]) - sum(
        len(paths) for paths in local_by_origin.values()
    )

    elsewhere = defaultdict(list)
    for manifest in others:
        per_host = defaultdict(list)
        for entry in manifest["repositories"]:
            if entry.get("origin"):
                per_host[entry["origin"]].append(entry["path"])
        for origin, paths in per_host.items():
            elsewhere[origin].append((manifest["host"], paths))

    majority = len(others) / 2
    only_here, missing, moved, attention = [], [], [], []
    clones, moves = [], []
    in_place = minority = 0
    for origin in sorted(set(local_by_origin) | set(elsewhere)):
        here = local_by_origin.get(origin, [])
        there = elsewhere.get(origin, [])
        hosts = [host for host, _paths in there]
        votes = Counter(paths[0] for _host, paths in there if len(paths) == 1)
        winner = next(
            (path for path, n in votes.items() if n > len(there) / 2), None
        )
        locations = ", ".join(
            "{}:{}".format(host, "|".join(paths)) for host, paths in there
        )

        if here and len(there) <= majority:
            only_here.append(
                (
                    " | ".join(here),
                    "also on " + host_list(hosts) if hosts else "only here",
                )
            )
        elif not here and len(there) > majority:
            if winner is None:
                attention.append(
                    (origin, "missing here; paths differ: " + locations)
                )
                continue
            problem = destination_problem(root, winner, local_paths)
            if problem:
                attention.append(
                    (winner, "missing here, cannot clone: " + problem)
                )
                continue
            missing.append((winner, "on " + host_list(hosts)))
            clones.append(
                (
                    winner,
                    suggested_command(
                        root,
                        winner,
                        "git",
                        "clone",
                        "--",
                        origin,
                        root / winner,
                    ),
                )
            )
        elif not here:
            minority += 1
        elif len(here) > 1:
            attention.append(
                (
                    " | ".join(here),
                    "duplicate checkouts here; elsewhere: " + locations,
                )
            )
        elif winner is None:
            attention.append(
                (here[0], "no majority path elsewhere: " + locations)
            )
        elif winner == here[0]:
            in_place += 1
        else:
            name = "{} -> {}".format(here[0], winner)
            agreeing = [host for host, paths in there if paths == [winner]]
            problem = destination_problem(root, winner, local_paths)
            if problem:
                attention.append((name, "cannot move: " + problem))
                continue
            moved.append((name, "on " + host_list(agreeing)))
            moves.append(
                (
                    here[0],
                    suggested_command(
                        root, winner, "mv", "--", root / here[0], root / winner
                    ),
                )
            )

    print_group("Here, missing on most other hosts", only_here)
    print_group("Missing here, present on most other hosts", missing)
    print_group("Here, at a different path from most other hosts", moved)
    print_group("Needs attention", attention)
    print(
        "\nIn place: {}. Elsewhere on a minority of hosts: {}. "
        "Here without an origin: {}.".format(in_place, minority, unlinked)
    )
    commands = sorted(clones) + sorted(moves)
    if commands:
        print("\nSuggested commands (not executed):")
        for _path, command in commands:
            print("  " + command)
    else:
        print("\nNo command suggestions.")
    return current


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--src-dir",
        type=Path,
        default=Path.home() / "src",
        help="repository scan root (default: ~/src)",
    )
    parser.add_argument(
        "--manifest-dir",
        type=Path,
        default=Path.home() / "data" / "repo-manifests",
        help="manifest directory (default: ~/data/repo-manifests)",
    )
    parser.add_argument(
        "--host", help="manifest host name (default: system hostname)"
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("scan", help="write this host's repository manifest")
    commands.add_parser(
        "reconcile", help="refresh this host and compare manifests"
    )
    args = parser.parse_args()
    try:
        if args.command == "scan":
            scan(args)
        else:
            reconcile(args)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print("repo-map: {}".format(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
