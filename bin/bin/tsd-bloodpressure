#!/usr/bin/env python3
"""tsd-bloodpressure — Blood pressure time series visualiser.

Reads $TSD_DIR/{bloodpressure-cuff-systolic,bloodpressure-cuff-diastolic,
bloodpressure-cuff-heartbeat} and plots three panels with a shared x-axis:

  Top panel   : barbell lines from diastolic to systolic per reading,
                trend lines, shaded normal-range band
  Middle panel: heart rate scatter + trend line
  Bottom strip: readings per week (a Gaussian density estimate) and a
                rug of reading dates

The trend is either the median of each DAYS-day bin (default: 30) or a
time-aware exponentially weighted moving average; the EWMA is drawn with
a lighter, faster-responding one alongside it.
"""

import argparse
import os
import sys
from pathlib import Path

import matplotlib.dates as mdates
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Half-life in days of the lighter EWMA drawn beside the main --ewma trend.
LIGHT_EWMA_HALFLIFE = 20.0

# Share of the density strip's height reserved for the reading rug.
DENSITY_RUG_FRACTION = 0.3

# ── TSD directory discovery ──────────────────────────────────────────────────

_TSD_CANDIDATES = [
    os.environ.get("TSD_DIR"),
    Path.home() / "tsd",
    Path.home() / "common" / "data" / "tsd",
    Path.home() / "data" / "tsd",
]


def find_tsd_dir() -> Path:
    for p in _TSD_CANDIDATES:
        if p and Path(p).is_dir():
            return Path(p)
    sys.exit("Cannot find TSD directory. Set $TSD_DIR or create ~/tsd.")


# ── Data loading ─────────────────────────────────────────────────────────────


def load_tsd(tsd_dir: Path, name: str) -> pd.DataFrame:
    path = tsd_dir / name
    if not path.exists():
        sys.exit(f"File not found: {path}")
    df = pd.read_csv(
        path,
        sep=r"\s+",
        header=None,
        names=["date", "value"],
        parse_dates=["date"],
        comment="#",
    )
    df = df.dropna()
    df = df.sort_values("date").reset_index(drop=True)
    return df


def binned_median(df: pd.DataFrame, days: float) -> pd.DataFrame:
    """Resample to one median value per non-empty bin of `days` days."""
    width = pd.Timedelta(days=days)
    med = (
        df.set_index("date")["value"]
        .resample(width)
        .median()
        .dropna()
        .reset_index()
    )
    # resample labels each bin by its start; plot it mid-bin instead.
    med["date"] += width / 2
    return med


def ewma(df: pd.DataFrame, halflife: float) -> pd.DataFrame:
    """Exponentially weighted moving average with a half-life in days.

    Weighting by time rather than by reading count keeps sparse periods
    from dragging the trend as far as dense ones.
    """
    values = df["value"].ewm(
        halflife=pd.Timedelta(days=halflife), times=df["date"]
    )
    return pd.DataFrame({"date": df["date"], "value": values.mean()})


def trend(df: pd.DataFrame, args: argparse.Namespace) -> pd.DataFrame:
    if args.ewma is not None:
        return ewma(df, args.ewma)
    return binned_median(df, args.median)


def trend_label(args: argparse.Namespace) -> str:
    if args.ewma is not None:
        return f"EWMA, half-life {args.ewma:g} d"
    return f"{args.median:g}-day median"


def plot_trends(
    ax: plt.Axes,
    df: pd.DataFrame,
    args: argparse.Namespace,
    colour: str,
    name: str,
) -> None:
    """Draw the main trend and, for EWMA, a lighter faster one."""
    main = trend(df, args)
    ax.plot(
        main["date"],
        main["value"],
        color=colour,
        lw=1.8,
        zorder=3,
        label=f"{name} ({trend_label(args)})",
    )
    if args.ewma is None or args.ewma == LIGHT_EWMA_HALFLIFE:
        return
    light = ewma(df, LIGHT_EWMA_HALFLIFE)
    ax.plot(
        light["date"],
        light["value"],
        color=colour,
        lw=1.2,
        alpha=0.45,
        zorder=3,
        label=f"{name} (EWMA, half-life {LIGHT_EWMA_HALFLIFE:g} d)",
    )


def reading_density(
    dates: pd.Series, sigma_days: float
) -> tuple[pd.DatetimeIndex, np.ndarray]:
    """Estimate readings per week with a Gaussian kernel on a daily grid.

    Near the first and last readings the kernel is renormalised over the
    days in between, so a steady rate does not appear to tail off at the
    ends of the record. This mirrors tsd-plot's density strip.
    """
    days = dates.dt.normalize()
    first, last = days.min(), days.max()
    grid = pd.date_range(first, last, freq="D")
    counts = days.value_counts().reindex(grid, fill_value=0).to_numpy(float)
    # Offsets beyond the grid never contribute, so cap the kernel there.
    radius = min(max(1, round(4 * sigma_days)), len(grid))
    offsets = np.arange(-radius, radius + 1, dtype=float)
    kernel = np.exp(-0.5 * (offsets / sigma_days) ** 2)
    # "full" then slicing keeps the grid's length even when the kernel is
    # longer than the grid, which "same" would not.
    window = slice(radius, radius + len(grid))
    smoothed = np.convolve(counts, kernel, mode="full")[window]
    support = np.convolve(np.ones(len(grid)), kernel, mode="full")[window]
    return grid, 7.0 * smoothed / support


def plot_density(ax: plt.Axes, dates: pd.Series, sigma_days: float) -> None:
    """Draw the reading density curve with a rug of reading dates."""
    colour = "slategray"
    grid, rates = reading_density(dates, sigma_days)
    ax.fill_between(grid, rates, color=colour, alpha=0.25, linewidth=0)
    ax.plot(
        grid,
        rates,
        color=colour,
        lw=1.2,
        label=f"Readings ({sigma_days:g} day bandwidth)",
    )
    # The rug sits in a band below zero so its ticks never hide the curve.
    ax.vlines(
        dates,
        0.1 * DENSITY_RUG_FRACTION,
        0.9 * DENSITY_RUG_FRACTION,
        transform=ax.get_xaxis_transform(),
        color=colour,
        lw=0.8,
    )
    peak = rates.max()
    top = peak * 1.1 if peak > 0 else 1.0
    ticks = plt.MaxNLocator(nbins=3).tick_values(0, top)
    ax.set_yticks([tick for tick in ticks if 0 <= tick <= top])
    ax.set_ylim(-top * DENSITY_RUG_FRACTION / (1 - DENSITY_RUG_FRACTION), top)
    ax.set_ylabel("Readings/week")
    ax.legend(fontsize=8, loc="upper left")


# ── Plot ─────────────────────────────────────────────────────────────────────


def plot(tsd_dir: Path, args: argparse.Namespace) -> None:
    sys_df = load_tsd(tsd_dir, "bloodpressure-cuff-systolic")
    dia_df = load_tsd(tsd_dir, "bloodpressure-cuff-diastolic")
    hr_df = load_tsd(tsd_dir, "bloodpressure-cuff-heartbeat")

    # Merge systolic + diastolic on date for barbell drawing.
    bp = pd.merge(
        sys_df.rename(columns={"value": "sys"}),
        dia_df.rename(columns={"value": "dia"}),
        on="date",
        how="inner",
    )

    fig, (ax_bp, ax_hr, ax_density) = plt.subplots(
        3,
        1,
        figsize=(14, 9),
        sharex=True,
        gridspec_kw={"height_ratios": [2, 1, 0.6]},
    )
    fig.suptitle("Blood pressure & heart rate", fontsize=13)

    # ── Top panel: barbell lines ─────────────────────────────────────────────

    # Shaded normal-range band (sys ≤ 120, dia ≤ 80).
    y_min = min(bp["dia"].min(), 40)
    ax_bp.axhspan(y_min, 80, color="palegreen", alpha=0.25, zorder=0)
    ax_bp.axhline(80, color="seagreen", ls="--", lw=0.8, alpha=0.6)
    ax_bp.axhline(120, color="seagreen", ls="--", lw=0.8, alpha=0.6)

    # One barbell per reading: vertical line + endpoint dots.
    for _, row in bp.iterrows():
        ax_bp.plot(
            [row["date"], row["date"]],
            [row["dia"], row["sys"]],
            color="slategray",
            lw=1,
            alpha=0.5,
            zorder=1,
        )
    ax_bp.scatter(
        bp["date"],
        bp["sys"],
        s=18,
        color="crimson",
        alpha=0.7,
        zorder=2,
        label="Systolic",
    )
    ax_bp.scatter(
        bp["date"],
        bp["dia"],
        s=18,
        color="steelblue",
        alpha=0.7,
        zorder=2,
        label="Diastolic",
    )

    plot_trends(ax_bp, sys_df, args, "darkred", "Systolic")
    plot_trends(ax_bp, dia_df, args, "navy", "Diastolic")

    ax_bp.set_ylabel("mmHg")
    ax_bp.set_title("Blood pressure")
    ax_bp.legend(fontsize=8, loc="upper left")

    # ── Bottom panel: heart rate ─────────────────────────────────────────────

    ax_hr.scatter(
        hr_df["date"],
        hr_df["value"],
        s=18,
        color="seagreen",
        alpha=0.6,
        label="Heart rate",
    )
    plot_trends(ax_hr, hr_df, args, "darkgreen", "Heart rate")

    ax_hr.set_ylabel("bpm")
    ax_hr.set_title("Heart rate")
    ax_hr.legend(fontsize=8, loc="upper left")

    # ── Bottom strip: reading density ────────────────────────────────────────

    plot_density(ax_density, bp["date"], args.density_days)

    # ── Shared x-axis formatting ─────────────────────────────────────────────

    ax_density.xaxis.set_major_locator(mdates.YearLocator())
    ax_density.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))
    for ax in (ax_bp, ax_hr, ax_density):
        plt.setp(ax.xaxis.get_majorticklabels(), visible=True)

    fig.tight_layout()
    plt.show()


# ── CLI ──────────────────────────────────────────────────────────────────────


def positive_float(text: str) -> float:
    try:
        value = float(text)
    except ValueError:
        value = 0.0
    if not value > 0:
        raise argparse.ArgumentTypeError(
            f"invalid value {text!r}: must be a positive number"
        )
    return value


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="tsd-bloodpressure",
        description=(
            "Plot blood pressure and heart rate from tsd files, with a"
            " trend line through each series."
        ),
        epilog=(
            "Data is read from $TSD_DIR, ~/tsd, ~/common/data/tsd or"
            " ~/data/tsd, whichever exists first."
        ),
    )
    smoothing = parser.add_mutually_exclusive_group()
    smoothing.add_argument(
        "--median",
        type=positive_float,
        nargs="?",
        const=30.0,
        default=30.0,
        metavar="DAYS",
        help="Trend is the median of each DAYS-day bin (default: 30)",
    )
    smoothing.add_argument(
        "--ewma",
        type=positive_float,
        nargs="?",
        const=60.0,
        metavar="HALFLIFE",
        help=(
            "Trend is an exponentially weighted moving average with a"
            " half-life of HALFLIFE days (default: 60), drawn with a"
            f" lighter {LIGHT_EWMA_HALFLIFE:g}-day one alongside it"
        ),
    )
    parser.add_argument(
        "--density-days",
        type=positive_float,
        default=15.0,
        metavar="DAYS",
        help=(
            "Gaussian bandwidth in days for the reading-density strip"
            " (default: 15)"
        ),
    )
    return parser.parse_args()


# ── Entry point ──────────────────────────────────────────────────────────────

if __name__ == "__main__":
    args = parse_args()
    tsd_dir = find_tsd_dir()
    plot(tsd_dir, args)
