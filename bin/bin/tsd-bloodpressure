#!/usr/bin/env python3
"""tsd-bloodpressure — Blood pressure time series visualiser.

Reads $TSD_DIR/{bloodpressure-cuff-systolic,bloodpressure-cuff-diastolic,
bloodpressure-cuff-heartbeat} and plots two panels with a shared x-axis:

  Top panel   : barbell lines from diastolic to systolic per reading,
                trend lines, shaded normal-range band
  Bottom panel: heart rate scatter + trend line

The trend is either the median of each DAYS-day bin (default: 30) or a
time-aware exponentially weighted moving average.
"""

import argparse
import os
import sys
from pathlib import Path

import matplotlib.dates as mdates
import matplotlib.pyplot as plt
import pandas as pd

# ── TSD directory discovery ──────────────────────────────────────────────────

_TSD_CANDIDATES = [
    os.environ.get("TSD_DIR"),
    Path.home() / "tsd",
    Path.home() / "common" / "data" / "tsd",
    Path.home() / "data" / "tsd",
]


def find_tsd_dir() -> Path:
    for p in _TSD_CANDIDATES:
        if p and Path(p).is_dir():
            return Path(p)
    sys.exit("Cannot find TSD directory. Set $TSD_DIR or create ~/tsd.")


# ── Data loading ─────────────────────────────────────────────────────────────


def load_tsd(tsd_dir: Path, name: str) -> pd.DataFrame:
    path = tsd_dir / name
    if not path.exists():
        sys.exit(f"File not found: {path}")
    df = pd.read_csv(
        path,
        sep=r"\s+",
        header=None,
        names=["date", "value"],
        parse_dates=["date"],
        comment="#",
    )
    df = df.dropna()
    df = df.sort_values("date").reset_index(drop=True)
    return df


def binned_median(df: pd.DataFrame, days: float) -> pd.DataFrame:
    """Resample to one median value per non-empty bin of `days` days."""
    width = pd.Timedelta(days=days)
    med = (
        df.set_index("date")["value"]
        .resample(width)
        .median()
        .dropna()
        .reset_index()
    )
    # resample labels each bin by its start; plot it mid-bin instead.
    med["date"] += width / 2
    return med


def ewma(df: pd.DataFrame, halflife: float) -> pd.DataFrame:
    """Exponentially weighted moving average with a half-life in days.

    Weighting by time rather than by reading count keeps sparse periods
    from dragging the trend as far as dense ones.
    """
    values = df["value"].ewm(
        halflife=pd.Timedelta(days=halflife), times=df["date"]
    )
    return pd.DataFrame({"date": df["date"], "value": values.mean()})


def trend(df: pd.DataFrame, args: argparse.Namespace) -> pd.DataFrame:
    if args.ewma is not None:
        return ewma(df, args.ewma)
    return binned_median(df, args.median)


def trend_label(args: argparse.Namespace) -> str:
    if args.ewma is not None:
        return f"EWMA, half-life {args.ewma:g} d"
    return f"{args.median:g}-day median"


# ── Plot ─────────────────────────────────────────────────────────────────────


def plot(tsd_dir: Path, args: argparse.Namespace) -> None:
    sys_df = load_tsd(tsd_dir, "bloodpressure-cuff-systolic")
    dia_df = load_tsd(tsd_dir, "bloodpressure-cuff-diastolic")
    hr_df = load_tsd(tsd_dir, "bloodpressure-cuff-heartbeat")

    # Merge systolic + diastolic on date for barbell drawing.
    bp = pd.merge(
        sys_df.rename(columns={"value": "sys"}),
        dia_df.rename(columns={"value": "dia"}),
        on="date",
        how="inner",
    )

    fig, (ax_bp, ax_hr) = plt.subplots(
        2,
        1,
        figsize=(14, 8),
        sharex=True,
        gridspec_kw={"height_ratios": [2, 1]},
    )
    fig.suptitle("Blood pressure & heart rate", fontsize=13)

    # ── Top panel: barbell lines ─────────────────────────────────────────────

    # Shaded normal-range band (sys ≤ 120, dia ≤ 80).
    y_min = min(bp["dia"].min(), 40)
    ax_bp.axhspan(y_min, 80, color="palegreen", alpha=0.25, zorder=0)
    ax_bp.axhline(80, color="seagreen", ls="--", lw=0.8, alpha=0.6)
    ax_bp.axhline(120, color="seagreen", ls="--", lw=0.8, alpha=0.6)

    # One barbell per reading: vertical line + endpoint dots.
    for _, row in bp.iterrows():
        ax_bp.plot(
            [row["date"], row["date"]],
            [row["dia"], row["sys"]],
            color="slategray",
            lw=1,
            alpha=0.5,
            zorder=1,
        )
    ax_bp.scatter(
        bp["date"],
        bp["sys"],
        s=18,
        color="crimson",
        alpha=0.7,
        zorder=2,
        label="Systolic",
    )
    ax_bp.scatter(
        bp["date"],
        bp["dia"],
        s=18,
        color="steelblue",
        alpha=0.7,
        zorder=2,
        label="Diastolic",
    )

    # Trend lines.
    label = trend_label(args)
    sys_med = trend(sys_df, args)
    dia_med = trend(dia_df, args)
    ax_bp.plot(
        sys_med["date"],
        sys_med["value"],
        color="darkred",
        lw=1.8,
        zorder=3,
        label=f"Systolic ({label})",
    )
    ax_bp.plot(
        dia_med["date"],
        dia_med["value"],
        color="navy",
        lw=1.8,
        zorder=3,
        label=f"Diastolic ({label})",
    )

    ax_bp.set_ylabel("mmHg")
    ax_bp.set_title("Blood pressure")
    ax_bp.legend(fontsize=8, loc="upper left")

    # ── Bottom panel: heart rate ─────────────────────────────────────────────

    ax_hr.scatter(
        hr_df["date"],
        hr_df["value"],
        s=18,
        color="seagreen",
        alpha=0.6,
        label="Heart rate",
    )
    hr_med = trend(hr_df, args)
    ax_hr.plot(
        hr_med["date"],
        hr_med["value"],
        color="darkgreen",
        lw=1.8,
        label=f"Heart rate ({label})",
    )

    ax_hr.set_ylabel("bpm")
    ax_hr.set_title("Heart rate")
    ax_hr.legend(fontsize=8, loc="upper left")

    # ── Shared x-axis formatting ─────────────────────────────────────────────

    ax_hr.xaxis.set_major_locator(mdates.YearLocator())
    ax_hr.xaxis.set_major_formatter(mdates.DateFormatter("%Y"))
    for ax in (ax_bp, ax_hr):
        plt.setp(ax.xaxis.get_majorticklabels(), visible=True)

    fig.tight_layout()
    plt.show()


# ── CLI ──────────────────────────────────────────────────────────────────────


def positive_float(text: str) -> float:
    try:
        value = float(text)
    except ValueError:
        value = 0.0
    if not value > 0:
        raise argparse.ArgumentTypeError(
            f"invalid value {text!r}: must be a positive number"
        )
    return value


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="tsd-bloodpressure",
        description=(
            "Plot blood pressure and heart rate from tsd files, with a"
            " trend line through each series."
        ),
        epilog=(
            "Data is read from $TSD_DIR, ~/tsd, ~/common/data/tsd or"
            " ~/data/tsd, whichever exists first."
        ),
    )
    smoothing = parser.add_mutually_exclusive_group()
    smoothing.add_argument(
        "--median",
        type=positive_float,
        nargs="?",
        const=30.0,
        default=30.0,
        metavar="DAYS",
        help="Trend is the median of each DAYS-day bin (default: 30)",
    )
    smoothing.add_argument(
        "--ewma",
        type=positive_float,
        nargs="?",
        const=14.0,
        metavar="HALFLIFE",
        help=(
            "Trend is an exponentially weighted moving average with a"
            " half-life of HALFLIFE days (default: 14)"
        ),
    )
    return parser.parse_args()


# ── Entry point ──────────────────────────────────────────────────────────────

if __name__ == "__main__":
    args = parse_args()
    tsd_dir = find_tsd_dir()
    plot(tsd_dir, args)
