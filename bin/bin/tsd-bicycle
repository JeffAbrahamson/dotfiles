#!/usr/bin/env python3
"""tsd-bicycle — Bicycle ride distance analytics.

Reads $TSD_DIR/bicycle-* files (date<tab>km format) and provides
summary statistics and plots.

Commands:
  year             List km per year across all bikes
  to-date          List km per year up to this day of the year
  bike             List km per bike (total)
  plot-bike        Bar chart: km per month, grouped by bicycle
  plot-cumulative  Cumulative km by year, starting at zero each year
  plot-density     Smooth Gaussian km rate by year

Options for to-date:
  --date [YYYY-]MM-DD       Count each year up to this month and day
                            (default: today); YYYY, if given, is the
                            latest year listed

Options for plot-cumulative, plot-density:
  --comparison-year YEAR    Highlight this year in red

Options for plot-density:
  --sigma DAYS              Gaussian smoothing width in days (default: 30)
"""

import argparse
import calendar
import functools
import os
import re
import sys
import textwrap
from collections import defaultdict
from datetime import date
from pathlib import Path

# ── TSD directory discovery ──────────────────────────────────────────────────

_TSD_CANDIDATES = [
    os.environ.get("TSD_DIR"),
    Path.home() / "tsd",
    Path.home() / "common" / "data" / "tsd",
    Path.home() / "data" / "tsd",
]


def find_tsd_dir() -> Path:
    for p in _TSD_CANDIDATES:
        if p and Path(p).is_dir():
            return Path(p)
    sys.exit("Cannot find TSD directory. Set $TSD_DIR or create ~/tsd.")


# ── Data loading ─────────────────────────────────────────────────────────────


def load_bicycle_data(tsd_dir: Path):
    """Return list of (bike_name, date, km) from all bicycle-* files."""
    records = []
    for path in sorted(tsd_dir.glob("bicycle-*")):
        bike = path.name.removeprefix("bicycle-")
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split()
                if len(parts) < 2:
                    continue
                try:
                    d = date.fromisoformat(parts[0])
                    km = float(parts[1])
                except (ValueError, TypeError):
                    continue
                records.append((bike, d, km))
    return records


# ── Text commands ────────────────────────────────────────────────────────────


def cmd_year(records):
    by_year = defaultdict(float)
    for _bike, d, km in records:
        by_year[d.year] += km
    for year in sorted(by_year):
        print(f"{year}  {by_year[year]:8.1f}")


DELTA_LIMIT_KM = 1500


def parse_to_date(text):
    """Parse MM-DD or YYYY-MM-DD into (year or None, month, day)."""
    try:
        parts = [int(p) for p in text.split("-")]
        if len(parts) == 2:
            year, (month, day) = None, parts
            # A leap year, so that 02-29 is accepted.
            date(2000, month, day)
        else:
            d = date.fromisoformat(text)
            year, month, day = d.year, d.month, d.day
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"invalid date {text!r}: use MM-DD or YYYY-MM-DD"
        )
    return year, month, day


def cmd_to_date(records, when=None):
    """Print km per year up to a month and day, newest year first.

    when is (year or None, month, day), defaulting to today; years after
    year (or the current year) are not listed.

    Each year is annotated with its difference from the best year at the
    same point, so the best year shows 0 and the others are negative.
    Deltas beyond DELTA_LIMIT_KM are omitted as noise.
    """
    today = date.today()
    last_year, month, day = when or (today.year, today.month, today.day)
    last_year = last_year or today.year
    cutoff = (month, day)
    by_year = defaultdict(float)
    for _bike, d, km in records:
        if d.year <= last_year and (d.month, d.day) <= cutoff:
            by_year[d.year] += km
    if not by_year:
        return
    best = max(by_year.values())
    # Round before formatting so a tiny negative doesn't print as "-0".
    deltas = {year: round(km - best) for year, km in by_year.items()}
    deltas = {y: d for y, d in deltas.items() if -d <= DELTA_LIMIT_KM}
    width = max(len(str(delta)) for delta in deltas.values())
    for year in sorted(by_year, reverse=True):
        line = f"{year}  {by_year[year]:8.0f}"
        if year in deltas:
            line += f"  [Δ {deltas[year]:{width}d} km]"
        print(line)


def cmd_bike(records):
    by_bike = defaultdict(float)
    for bike, _d, km in records:
        by_bike[bike] += km
    for bike, total in sorted(by_bike.items(), key=lambda x: -x[1]):
        print(f"{bike:<25}  {total:8.0f}")


# ── Plot commands ────────────────────────────────────────────────────────────


def cmd_plot_bike(records):
    import matplotlib.pyplot as plt
    import numpy as np

    by_bike_month = defaultdict(lambda: defaultdict(float))
    for bike, d, km in records:
        by_bike_month[bike][d.month] += km

    bikes = sorted(by_bike_month)
    months = list(range(1, 13))
    month_names = [calendar.month_abbr[m] for m in months]

    n_bikes = len(bikes)
    x = np.arange(12)
    bar_width = 0.8 / max(n_bikes, 1)

    fig, ax = plt.subplots(figsize=(14, 6))
    colors = plt.cm.tab10(np.linspace(0, 1, max(n_bikes, 1)))

    for i, bike in enumerate(bikes):
        data = [by_bike_month[bike].get(m, 0) for m in months]
        offset = (i - n_bikes / 2 + 0.5) * bar_width
        ax.bar(x + offset, data, bar_width, label=bike, color=colors[i])

    ax.set_xlabel("Month")
    ax.set_ylabel("km")
    ax.set_title("Bicycle distance by month and bicycle")
    ax.set_xticks(x)
    ax.set_xticklabels(month_names)
    ax.legend()
    plt.tight_layout()
    plt.show()


def _year_style(year, current_year, comparison_year=None):
    """Return matplotlib line kwargs for a given year."""
    if year == current_year:
        return {
            "color": "#2563EB",
            "linewidth": 2.5,
            "zorder": 10,
            "alpha": 1.0,
        }
    if year == comparison_year:
        return {
            "color": "#DC2626",
            "linewidth": 2.2,
            "zorder": 9,
            "alpha": 1.0,
        }
    age = current_year - year
    gray = min(0.12 + (age - 1) * 0.10, 0.72)
    lw = max(1.8 - (age - 1) * 0.15, 0.7)
    return {
        "color": str(gray),
        "linewidth": lw,
        "zorder": max(8 - age, 1),
        "alpha": 1.0,
    }


def _sorted_legend(ax):
    """Reorder legend: current/most-recent year first, descending."""
    handles, labels = ax.get_legend_handles_labels()
    pairs = sorted(zip(labels, handles), key=lambda lh: -int(lh[0]))
    if pairs:
        sl, sh = zip(*pairs)
        ax.legend(sh, sl, loc="upper left")


def cmd_plot_cumulative(records, comparison_year=None):
    import matplotlib.pyplot as plt

    today = date.today()
    current_year = today.year

    by_year = defaultdict(list)
    for _bike, d, km in records:
        by_year[d.year].append((d.timetuple().tm_yday, km))

    years = sorted(by_year)

    fig, ax = plt.subplots(figsize=(14, 7))

    # Plot older years first so current year renders on top.
    for year in years:
        rides = sorted(by_year[year])

        # Build step-cumulative curve starting from (0, 0).
        doys = [0]
        cumkm = [0.0]
        total = 0.0
        for doy, km in rides:
            total += km
            doys.append(doy)
            cumkm.append(total)

        # Extend line to end of year (or today for current year).
        if year == current_year:
            end_doy = today.timetuple().tm_yday
        else:
            end_doy = 366 if calendar.isleap(year) else 365
        doys.append(end_doy)
        cumkm.append(total)

        style = _year_style(year, current_year, comparison_year)
        ax.step(doys, cumkm, where="post", label=str(year), **style)

    month_doys = [date(2001, m, 1).timetuple().tm_yday for m in range(1, 13)]
    ax.set_xticks(month_doys)
    ax.set_xticklabels([calendar.month_abbr[m] for m in range(1, 13)])
    ax.set_xlim(0, 366)
    ax.set_ylabel("Cumulative km")
    ax.set_title("Cumulative bicycle distance by year")
    _sorted_legend(ax)
    plt.tight_layout()
    plt.show()


def cmd_plot_density(records, comparison_year=None, sigma=30.0):
    import math
    import matplotlib.pyplot as plt

    today = date.today()
    current_year = today.year
    today_doy = today.timetuple().tm_yday

    by_year = defaultdict(list)
    for _bike, d, km in records:
        by_year[d.year].append((d.timetuple().tm_yday, km))

    years = sorted(by_year)
    # Scale so output is in km/month regardless of sigma.
    scale = 30.0 / (sigma * math.sqrt(2 * math.pi))

    fig, ax = plt.subplots(figsize=(14, 7))

    for year in years:
        rides = by_year[year]
        end_doy = today_doy if year == current_year else 365
        doys = list(range(1, end_doy + 1))
        values = [
            scale
            * sum(
                km * math.exp(-0.5 * ((d - doy) / sigma) ** 2)
                for doy, km in rides
            )
            for d in doys
        ]
        style = _year_style(year, current_year, comparison_year)
        ax.plot(doys, values, label=str(year), **style)

    month_doys = [date(2001, m, 1).timetuple().tm_yday for m in range(1, 13)]
    ax.set_xticks(month_doys)
    ax.set_xticklabels([calendar.month_abbr[m] for m in range(1, 13)])
    ax.set_xlim(1, 365)
    ax.set_ylabel("km / month")
    ax.set_title("Bicycle distance density by year")
    _sorted_legend(ax)
    plt.tight_layout()
    plt.show()


# ── CLI ──────────────────────────────────────────────────────────────────────


class CommandOptionsHelpFormatter(argparse.HelpFormatter):
    """List each command's options beneath it in the top-level help.

    argparse only shows a subcommand's options in that subcommand's own
    help, which makes them hard to discover.
    """

    def __init__(self, prog, commands=None, **kwargs):
        super().__init__(prog, **kwargs)
        self._command_options = {
            name: [
                a
                for a in command._actions
                if a.option_strings and a.dest != "help"
            ]
            for name, command in (commands or {}).items()
        }

    # Python 3.14 colours option names when writing to a terminal.
    _ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")

    def _visible_len(self, text):
        return len(self._ANSI_ESCAPE.sub("", text))

    def _format_action(self, action):
        text = super()._format_action(action)
        options = self._command_options.get(action.dest)
        if not options:
            return text
        indent = self._current_indent + 2
        # One help column for every command, so all the options line up.
        width = max(
            self._visible_len(self._format_action_invocation(a))
            for opts in self._command_options.values()
            for a in opts
        )
        column = indent + width + 2
        lines = []
        for option in options:
            invocation = self._format_action_invocation(option)
            helps = textwrap.wrap(
                option.help or "", max(self._width - column, 20)
            )
            helps = helps or [""]
            padding = " " * (width + 2 - self._visible_len(invocation))
            lines.append(" " * indent + invocation + padding + helps[0])
            lines += [" " * column + h for h in helps[1:]]
        return text + "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(
        prog="tsd-bicycle",
        description="Bicycle ride distance analytics from tsd files.",
    )
    sub = parser.add_subparsers(dest="command", metavar="COMMAND")

    sub.add_parser("year", help="List km per year across all bikes")
    p_td = sub.add_parser(
        "to-date", help="List km per year up to this day of the year"
    )
    p_td.add_argument(
        "--date",
        type=parse_to_date,
        metavar="[YYYY-]MM-DD",
        help=(
            "Count each year up to this month and day (default: today);"
            " YYYY, if given, is the latest year listed"
        ),
    )
    sub.add_parser("bike", help="List total km per bike, sorted by distance")
    sub.add_parser(
        "plot-bike", help="Bar chart: km per month, grouped by bicycle"
    )

    _cy_kwargs = {
        "type": int,
        "metavar": "YEAR",
        "help": "Highlight this year in red",
    }

    p_cum = sub.add_parser(
        "plot-cumulative",
        help="Cumulative km by year (starting at zero each year)",
    )
    p_cum.add_argument("--comparison-year", **_cy_kwargs)

    p_dens = sub.add_parser(
        "plot-density",
        help="Smooth Gaussian km rate by year",
    )
    p_dens.add_argument("--comparison-year", **_cy_kwargs)
    p_dens.add_argument(
        "--sigma",
        type=float,
        metavar="DAYS",
        default=30.0,
        help="Gaussian smoothing width in days (default: 30)",
    )

    parser.formatter_class = functools.partial(
        CommandOptionsHelpFormatter, commands=sub.choices
    )
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    tsd_dir = find_tsd_dir()
    records = load_bicycle_data(tsd_dir)

    if not records:
        sys.exit("No bicycle data found in " + str(tsd_dir))

    comparison = getattr(args, "comparison_year", None)
    if args.command == "year":
        cmd_year(records)
    elif args.command == "to-date":
        cmd_to_date(records, when=args.date)
    elif args.command == "bike":
        cmd_bike(records)
    elif args.command == "plot-bike":
        cmd_plot_bike(records)
    elif args.command == "plot-cumulative":
        cmd_plot_cumulative(records, comparison_year=comparison)
    elif args.command == "plot-density":
        cmd_plot_density(records, comparison_year=comparison, sigma=args.sigma)


if __name__ == "__main__":
    main()
