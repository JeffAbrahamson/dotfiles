# Usage: awsp [PROFILE]
# With no argument, print the current AWS_* environment variables.
# With an argument, export AWS_PROFILE=PROFILE for the AWS CLI/SDKs to use.
awsp() {
    if [ $# -eq 0 ]; then
        env | grep '^AWS_' | sort
        return
    fi
    export AWS_PROFILE=$1
}

# Usage: aws-s3-list [region|name]
# List S3 buckets, sorted for readability.
#   (no arg)  sort by region, then by name within region
#   region    sort by region only (server-side)
#   name      sort by name only (server-side)
aws-s3-list() {
    # --prefix '' is required on every branch below: S3's ListBuckets only
    # includes BucketRegion in the response when the request carries at
    # least one of the region/prefix filter params, even an empty one.
    # Without it, region comes back empty (printed as "None").
    case "$1" in
        region)
            aws s3api list-buckets \
                --prefix '' \
                --query 'sort_by(Buckets,&BucketRegion)[].[Name,BucketRegion]' \
                --output table \
                --page-size 1000
            ;;
        name)
            aws s3api list-buckets \
                --prefix '' \
                --query 'sort_by(Buckets,&Name)[].[Name,BucketRegion]' \
                --output table \
                --page-size 1000
            ;;
        *)
            aws s3api list-buckets \
                --prefix '' \
                --query 'Buckets[].[BucketRegion,Name]' \
                --output text \
                --page-size 1000 |
            sort -k1,1 -k2,2 | column -t
            ;;
    esac
}

# Usage: aws-s3-audit
# Report, one row per bucket: region, whether the bucket policy makes it
# public, and its S3 Block Public Access settings.
# Set AWS_S3_AUDIT_JOBS to control the number of buckets queried in parallel.
aws-s3-audit() {
    local active_jobs=0
    local max_jobs=${AWS_S3_AUDIT_JOBS:-8}
    local bucket_list

    if [[ ! $max_jobs =~ ^[1-9][0-9]*$ ]]; then
        printf 'aws-s3-audit: AWS_S3_AUDIT_JOBS must be a positive integer\n' >&2
        return 2
    fi

    # --prefix '' is required to get BucketRegion back (see aws-s3-list
    # above). Without it, region comes back as "None", which then gets
    # passed as an invalid --region to the per-bucket calls below and
    # makes them fail across the board.
    bucket_list=$(
        aws s3api list-buckets \
            --prefix '' \
            --query 'Buckets[].[Name,BucketRegion]' \
            --output text
    ) || return

    {
        printf 'BUCKET\tREGION\tPUBLIC_POLICY\tBLOCK_ACLS\tIGNORE_ACLS\tBLOCK_POLICY\tRESTRICT_PUBLIC\n'

        # A here-string, unlike a pipe, keeps this loop in the current
        # shell, so the background jobs it starts are direct children and
        # the `wait` below actually sees them.
        while IFS=$'\t' read -r bucket region; do
            [ -n "$bucket" ] || continue
            (
                local block_settings public_policy

                if ! block_settings=$(
                    aws s3api get-public-access-block \
                        --bucket "$bucket" \
                        --region "$region" \
                        --query '[
                          PublicAccessBlockConfiguration.BlockPublicAcls,
                          PublicAccessBlockConfiguration.IgnorePublicAcls,
                          PublicAccessBlockConfiguration.BlockPublicPolicy,
                          PublicAccessBlockConfiguration.RestrictPublicBuckets
                        ]' \
                        --output text 2>/dev/null
                ); then
                    block_settings=$(printf 'UNSET\tUNSET\tUNSET\tUNSET')
                fi

                if ! public_policy=$(
                    aws s3api get-bucket-policy-status \
                        --bucket "$bucket" \
                        --region "$region" \
                        --query 'PolicyStatus.IsPublic' \
                        --output text 2>/dev/null
                ); then
                    public_policy='NONE/ERROR'
                fi

                printf '%s\t%s\t%s\t%s\n' \
                    "$bucket" "$region" "$public_policy" "$block_settings"
            ) &

            ((active_jobs += 1))
            if (( active_jobs >= max_jobs )); then
                wait -n
                ((active_jobs -= 1))
            fi
        done <<< "$bucket_list"

        wait
    } | column -t -s $'\t'
}

# Usage: aws-s3-account-block [region]
# Show the account-level S3 Block Public Access configuration (the
# account-wide setting, separate from each bucket's own settings).
aws-s3-account-block() {
    local account_id region

    region=${1:-${AWS_REGION:-${AWS_DEFAULT_REGION:-}}}
    if [[ -z $region ]]; then
        region=$(aws configure get region 2>/dev/null) || true
    fi
    region=${region:-us-east-1}

    account_id=$(aws sts get-caller-identity --query Account --output text) ||
        return

    aws s3control get-public-access-block \
        --account-id "$account_id" \
        --region "$region" \
        --output table
}
