#!/bin/bash

# At beginning of life, this is simply a copy of i3-env-stats (with
# s/i3/sway/g).  I've made the copy so that it can evolve without my
# having to think about backwards compatibility with i3, in case I'm
# ever again running i3.

. $HOME/bin/p27.sh
log_to_file sway-env-stats.log

PATH=$HOME/bin:/usr/bin:/bin
renice -n 19 $$

# Record all temperature channels exported by the kernel's hwmon interface.
# lm-sensors uses the same interface, but reading it directly avoids depending
# on the presentation and localisation of the `sensors` command's output.
record_temperatures()
{
    series_base="$1"
    status_file="$2"
    now=$(date +%s)
    status=""
    fallback_status=""
    maximum=""

    mkdir -p "$series_base"
    for input in /sys/class/hwmon/hwmon*/temp*_input; do
	[ -r "$input" ] || continue
	value=$(cat "$input")
	case "$value" in
	    ''|*[!0-9-]*) continue ;;
	esac

	hwmon_dir=$(dirname "$input")
	channel=${input%_input}
	chip=$(cat "$hwmon_dir/name" 2>/dev/null || basename "$hwmon_dir")
	label=$(cat "${channel}_label" 2>/dev/null || basename "$channel")
	name="$chip:$label"
	series_name=$(printf '%s-%s' "$chip" "$label" |
	    tr '[:upper:] ' '[:lower:]_' | tr -cd '[:alnum:]_.-')
	degrees=$(awk -v value="$value" 'BEGIN { printf "%.1f", value / 1000 }')
	printf '%s %s\n' "$now" "$degrees" >> "$series_base/temperature-$series_name"
	max=$(cat "${channel}_max" 2>/dev/null || true)
	crit=$(cat "${channel}_crit" 2>/dev/null || true)
	max_degrees=""
	crit_degrees=""
	case "$max" in
	    ''|*[!0-9-]*) ;;
	    *) max_degrees=$(awk -v value="$max" 'BEGIN { printf "%.1f", value / 1000 }') ;;
	esac
	case "$crit" in
	    ''|*[!0-9-]*) ;;
	    *) crit_degrees=$(awk -v value="$crit" 'BEGIN { printf "%.1f", value / 1000 }') ;;
	esac
	state=normal
	[ -n "$max_degrees" ] && [ "$value" -ge "$max" ] && state=max
	[ -n "$crit_degrees" ] && [ "$value" -ge "$crit" ] && state=critical
	status_line=$(printf '%s\t%s\t%s\t%s\t%s' \
	    "$name" "$degrees" "$max_degrees" "$crit_degrees" "$state")

	if [ -z "$maximum" ] || [ "$value" -gt "$maximum" ]; then
	    maximum=$value
	    fallback_status=$status_line
	fi
	case "$label" in
	    *Package*|*Tctl*|*Tdie*|*Composite*|edge)
		status="$status${status:+
}$status_line"
		;;
	esac
    done

    # Some drivers only expose generic tempN labels.  Showing the maximum is
    # more useful than either a long list or an empty status block.
    if [ -z "$status" ] && [ -n "$maximum" ]; then
	status=$fallback_status
    fi

    status_tmp="$status_file.new"
    printf '%s\n' "$status" > "$status_tmp"
    mv "$status_tmp" "$status_file"
}

# Functions to monitor disk usage.
# This is a bit hard-coded.  It's also largely copied from disk-usage.sh.

# Return size in megabytes for partition containing $1.
get_size()
{
    df -BM "$1" | grep --fixed-strings "$1" | awk '{print $3}' | tr -d M
}

# Return space remaining in megabytes for partition $1.
get_remaining()
{
    df -BM "$1" | grep --fixed-strings "$1" | awk '{print $4}' | tr -d M
}

# Write time and size in megabytes of partition containing $1 to datafile $2.
record_size()
{
    now=$(date +%s)
    size=$(get_size "$1")
    remaining=$(get_remaining "$1")
    echo $now $size >> "$2"
    echo $now $remaining >> "$2"-remaining
}

# Record space used and space remaining for partition containing
record_size_for()
{
    dir="$1"
    series="$2"
    series_base="$3"
    if [ -d "$dir" ]; then
	if [ $( ls "$dir" | wc -l ) -gt 0 ] ; then
	    record_size "$dir" "$series_base$series"
	fi
    fi
}

record_disk_usage() {
    series_base="$1"
    # I think what I care about and what is ext4 is precisely identical.
    disks=$(cat /proc/mounts | awk '/ext4/ {print $1}')
    for disk in $disks; do
	mount_dir=$(df --output=target $mount_point | tail -1)
	record_size_for "$mount_dir" "$(basename $disk)" "$series_base"
    done
}

# Sway starts us detached, so its exit doesn't stop us; left running, we
# keep the logind session open after logout.  Sway removes its socket on
# exit, so watch that.  Without SWAYSOCK (run by hand) never stop.
sway_running()
{
    [ -z "${SWAYSOCK-}" ] || [ -S "$SWAYSOCK" ]
}

# Sleep $1 seconds in short steps, exiting as soon as sway has gone.
nap()
{
    local remaining=$1 step
    while [ "$remaining" -gt 0 ]; do
	if ! sway_running; then
	    log_line "Sway has exited; exiting."
	    exit 0
	fi
	step=$(( remaining < 15 ? remaining : 15 ))
	sleep $step
	remaining=$(( remaining - step ))
    done
}

log_line "Starting..."
SERIES_BASE=$HOME/data/hosts/$(hostname -s)/disk-
TEMPERATURE_SERIES_DIR=$HOME/data/hosts/$(hostname -s)
TEMPERATURE_STATUS=$HOME/.temperature-status
record_frequency_minutes=11
# Ookla rejects runs it considers too frequent ("Limit reached: Too many
# requests") without saying what the limit is, and counts every host on
# the same connection together.  Hourly seems to stay under it.
speedtest_frequency_minutes=60
last_speedtest=0
# time_delta=$(( $record_frequency_minutes * 60 ))
log_line "Log frequency = $record_frequency_minutes minutes."
log_line "Speedtest frequency = $speedtest_frequency_minutes minutes."
# Temperature collection is cheap and gives swaybar useful data immediately.
record_temperatures "$TEMPERATURE_SERIES_DIR" "$TEMPERATURE_STATUS"
# First recording should not be immediate.  On session start, we may
# not have a network connection.  In addition, it's annoying for
# starting daemons immediately to monopolise resources.
nap 300
while true; do
    log_line Recording
    record_disk_usage $SERIES_BASE
    now=$(date +%s)
    if (( now - last_speedtest >= speedtest_frequency_minutes * 60 )); then
	speedtest
	last_speedtest=$now
    fi
    # I'd like to monitor connectivity more frequently than I record
    # disk usage, as it's a lighter test.  So rather than sleeping for
    #     $(( $record_frequency_minutes * 60 + $RANDOM / 3277 ))
    # I loop and call up-monitor about once a minute.  The end result
    # is sleeping about $record_frequency_minutes between recordings.
    loop_index=$record_frequency_minutes
    while [[ $loop_index -gt 0 ]]; do
	up-monitor
	record_temperatures "$TEMPERATURE_SERIES_DIR" "$TEMPERATURE_STATUS"
	# Sleep a bit less than a minute : 45 seconds plus 0-9 seconds
	# more to avoid any synchronisation issues.  RANDOM is an
	# integer in [0, 32767].
	sleep_time=$(( 45 + $RANDOM / 3277 ))
	log_line Sleeping $sleep_time seconds.
	nap $sleep_time
	loop_index=$(( $loop_index - 1 ))
    done
done
